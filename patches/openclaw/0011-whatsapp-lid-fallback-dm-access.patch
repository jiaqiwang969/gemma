+function normalizeWhatsAppPeerId(value: string): string {
+  const withoutPrefix = value.replace(/^whatsapp:/, "").trim();
+
+  // Common WhatsApp DM JID -> E.164 (e.g. 123:1@s.whatsapp.net -> +123).
+  const e164JidMatch = withoutPrefix.match(/^(\d+)(?::\d+)?@(s\.whatsapp\.net|hosted)$/i);
+  if (e164JidMatch) {
+    return `+${e164JidMatch[1]}`;
+  }
+
+  // LID JIDs (linked IDs) cannot be reliably mapped to phone numbers without state;
+  // normalize the JID shape so allowlists can include raw LIDs (e.g. 999@lid).
+  const lidJidMatch = withoutPrefix.match(/^(\d+)(?::\d+)?@(lid|hosted\.lid)$/i);
+  if (lidJidMatch) {
+    return `${lidJidMatch[1]}@lid`;
+  }
+
+  if (withoutPrefix.includes("@")) {
+    // Generic JID normalization (strip device suffix, lowercase domain).
+    const match = withoutPrefix.match(/^([^@]+)@(.+)$/);
+    if (!match) {
+      return withoutPrefix.toLowerCase();
+    }
+    const user = match[1].replace(/:\d+$/, "");
+    const domain = match[2].toLowerCase();
+    return `${user}@${domain}`;
+  }
+
+  return normalizeE164(withoutPrefix);
+}
