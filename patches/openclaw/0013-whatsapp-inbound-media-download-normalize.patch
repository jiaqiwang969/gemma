+++ b/src/web/inbound/media.ts
@@ -33,18 +33,53 @@ export async function downloadInboundMedia(
     return undefined;
   }
   try {
+    // Some WhatsApp messages wrap media inside ephemeral/view-once containers.
+    // We already normalized `message` above, but Baileys' downloadMediaMessage() reads
+    // from `msg.message`. When the raw message is still wrapped, downloads can fail.
+    const baseMsg = msg as WAMessage;
+    const normalizedMsg = { ...(msg as WAMessage), message: message as proto.IMessage } as WAMessage;
+
+    // WhatsApp media downloads can be flaky right after connect/resume; retry quickly.
+    const retryDelaysMs = [0, 700] as const;
+    for (const delayMs of retryDelaysMs) {
+      if (delayMs > 0) {
+        await new Promise((resolve) => setTimeout(resolve, delayMs));
+      }
+
+      try {
+        const buffer = await downloadMediaMessage(
+          baseMsg,
+          "buffer",
+          {},
+          {
+            reuploadRequest: sock.updateMediaMessage,
+            logger: sock.logger,
+          },
+        );
+        return { buffer, mimetype };
+      } catch (err) {
+        logVerbose(`downloadMediaMessage failed (raw): ${String(err)}`);
+      }
+
+      try {
+        const buffer = await downloadMediaMessage(
+          normalizedMsg,
+          "buffer",
+          {},
+          {
+            reuploadRequest: sock.updateMediaMessage,
+            logger: sock.logger,
+          },
+        );
+        return { buffer, mimetype };
+      } catch (err) {
+        logVerbose(`downloadMediaMessage failed (normalized): ${String(err)}`);
+      }
+    }
+
+    return undefined;
+  } catch (err) {
+    logVerbose(`downloadMediaMessage failed (unexpected): ${String(err)}`);
+    return undefined;
+  }
