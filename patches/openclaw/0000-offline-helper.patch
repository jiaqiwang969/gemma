+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../models-config.js", () => ({
+  ensureOpenClawModelsJson: vi.fn(async () => ({ agentDir: "/tmp/openclaw-agent", wrote: false })),
+}));
+
+vi.mock("./model.js", () => ({
+  resolveModel: vi.fn(() => ({
+    model: {
+      id: "claude-opus-4-5",
+      name: "claude-opus-4-5",
+      provider: "anthropic",
+      api: "anthropic-messages",
+      // Missing baseUrl simulates the default remote endpoint (blocked in offline mode).
+      baseUrl: undefined,
+      reasoning: false,
+      input: ["text"],
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      contextWindow: 1,
+      maxTokens: 1,
+    },
+    authStorage: {},
+    modelRegistry: {},
+  })),
+}));
+
+import { runEmbeddedPiAgent } from "./run.js";
+
+describe("runEmbeddedPiAgent offline mode", () => {
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it("refuses non-local model endpoints when offline", async () => {
+    vi.stubEnv("OPENCLAW_OFFLINE", "1");
+
+    await expect(
+      runEmbeddedPiAgent({
+        sessionId: "probe-offline",
+        sessionFile: "/tmp/openclaw-session.jsonl",
+        workspaceDir: "/tmp",
+        prompt: "hello",
+        timeoutMs: 1000,
+        runId: "test",
+        // Bypass the command queue for unit tests.
+        enqueue: (task) => task(),
+      }),
+    ).rejects.toThrow(/Offline mode is enabled/);
+  });
+});
