+function hasBinaryOnPath(bin: string): boolean {
+  const pathEnv = process.env.PATH ?? "";
+  const parts = pathEnv.split(path.delimiter).filter(Boolean);
+  for (const part of parts) {
+    try {
+      if (existsSync(path.join(part, bin))) {
+        return true;
+      }
+    } catch {
+      // ignore
+    }
+  }
+  return false;
+}
+
+async function macosSayTTS(params: {
+  text: string;
+  tempDir: string;
+  config: ResolvedTtsConfig["macosSay"];
+  timeoutMs: number;
+}): Promise<{ audioPath: string; outputFormat: string }> {
+  if (process.platform !== "darwin") {
+    throw new Error("macos-say is only supported on macOS");
+  }
+  if (!params.config.enabled) {
+    throw new Error("macos-say is disabled");
+  }
+  if (!existsSync("/usr/bin/say")) {
+    throw new Error("macos-say unavailable: missing /usr/bin/say");
+  }
+
+  const aiffPath = path.join(params.tempDir, `say-${Date.now()}.aiff`);
+  const sayArgs: string[] = [];
+  if (params.config.voice?.trim()) {
+    sayArgs.push("-v", params.config.voice.trim());
+  }
+  if (typeof params.config.rate === "number" && Number.isFinite(params.config.rate)) {
+    sayArgs.push("-r", String(Math.max(1, Math.floor(params.config.rate))));
+  }
+  sayArgs.push("-o", aiffPath, params.text);
+
+  const sayRes = await runCommandWithTimeout(["say", ...sayArgs], {
+    timeoutMs: params.timeoutMs,
+  });
+  if (sayRes.code !== 0) {
+    const detail = sayRes.stderr.trim() || sayRes.stdout.trim() || "unknown error";
+    throw new Error(`macos-say failed: ${detail}`);
+  }
+
+  if (params.config.preferOpus && hasBinaryOnPath("ffmpeg")) {
+    const oggPath = path.join(params.tempDir, `voice-${Date.now()}.ogg`);
+    const ffRes = await runCommandWithTimeout(
+      [
+        "ffmpeg",
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        "-y",
+        "-i",
+        aiffPath,
+        "-ac",
+        "1",
+        "-c:a",
+        "libopus",
+        "-b:a",
+        "24k",
+        oggPath,
+      ],
+      { timeoutMs: params.timeoutMs },
+    );
+    if (ffRes.code === 0 && existsSync(oggPath)) {
+      return { audioPath: oggPath, outputFormat: "ogg-opus" };
+    }
+  }
+
+  if (!existsSync("/usr/bin/afconvert")) {
+    throw new Error("macos-say conversion failed and /usr/bin/afconvert is missing");
+  }
+
+  const m4aPath = path.join(params.tempDir, `voice-${Date.now()}.m4a`);
+  const afRes = await runCommandWithTimeout(
+    ["afconvert", "-f", "m4af", "-d", "aac", aiffPath, m4aPath],
+    { timeoutMs: params.timeoutMs },
+  );
+  if (afRes.code === 0 && existsSync(m4aPath)) {
+    return { audioPath: m4aPath, outputFormat: "m4a-aac" };
+  }
+
+  const detail = afRes.stderr.trim() || afRes.stdout.trim() || "unknown error";
+  throw new Error(`macos-say conversion failed: ${detail}`);
+}
