+async function maybeTranscodeAudioForWhisperCli(params: {
+  inputPath: string;
+  outputDir: string;
+  timeoutMs: number;
+}): Promise<{ path: string; didTranscode: boolean }> {
+  const ext = path.extname(params.inputPath).toLowerCase();
+  if (ext === ".wav") {
+    return { path: params.inputPath, didTranscode: false };
+  }
+
+  const wavPath = path.join(params.outputDir, "whisper-input.wav");
+  const transcodeTimeoutMs = Math.min(90_000, Math.max(10_000, params.timeoutMs));
+
+  // On macOS, `afconvert` is available out of the box and supports Opus/OGG from WhatsApp.
+  if (process.platform === "darwin") {
+    try {
+      await runExec(
+        "afconvert",
+        ["-f", "WAVE", "-d", "LEI16@16000", "-c", "1", params.inputPath, wavPath],
+        { timeoutMs: transcodeTimeoutMs, maxBuffer: CLI_OUTPUT_MAX_BUFFER },
+      );
+      if (await fileExists(wavPath)) {
+        return { path: wavPath, didTranscode: true };
+      }
+    } catch {
+      // Fall through to ffmpeg if present.
+    }
+  }
+
+  // Fallback: use ffmpeg if installed (best-effort for non-macOS environments).
+  if (await hasBinary("ffmpeg")) {
+    try {
+      await runExec(
+        "ffmpeg",
+        [
+          "-y",
+          "-nostdin",
+          "-hide_banner",
+          "-loglevel",
+          "error",
+          "-i",
+          params.inputPath,
+          "-ar",
+          "16000",
+          "-ac",
+          "1",
+          "-f",
+          "wav",
+          wavPath,
+        ],
+        { timeoutMs: transcodeTimeoutMs, maxBuffer: CLI_OUTPUT_MAX_BUFFER },
+      );
+      if (await fileExists(wavPath)) {
+        return { path: wavPath, didTranscode: true };
+      }
+    } catch {
+      // Best-effort: leave input unchanged.
+    }
+  }
+
+  return { path: params.inputPath, didTranscode: false };
+}
