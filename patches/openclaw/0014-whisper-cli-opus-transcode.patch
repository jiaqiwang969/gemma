--- /dev/null
+++ b/src/media-understanding/runner.whisper-cli-transcode.test.ts
@@ -0,0 +1,111 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { MsgContext } from "../auto-reply/templating.js";
+import type { OpenClawConfig } from "../config/config.js";
+
+const runExecMock = vi.fn();
+
+vi.mock("../process/exec.js", () => ({
+  runExec: (...args: unknown[]) => runExecMock(...args),
+}));
+
+const envSnapshot = () => ({
+  PATH: process.env.PATH,
+  WHISPER_CPP_MODEL: process.env.WHISPER_CPP_MODEL,
+  OPENCLAW_OFFLINE: process.env.OPENCLAW_OFFLINE,
+});
+
+const restoreEnv = (snapshot: ReturnType<typeof envSnapshot>) => {
+  process.env.PATH = snapshot.PATH;
+  process.env.WHISPER_CPP_MODEL = snapshot.WHISPER_CPP_MODEL;
+  process.env.OPENCLAW_OFFLINE = snapshot.OPENCLAW_OFFLINE;
+};
+
+describe("whisper-cli input transcoding", () => {
+  afterEach(() => {
+    runExecMock.mockReset();
+  });
+
+  it("transcodes non-wav audio before invoking whisper-cli", async () => {
+    // afconvert is macOS-only; the production code falls back to ffmpeg on other platforms.
+    if (process.platform !== "darwin") {
+      return;
+    }
+
+    const snapshot = envSnapshot();
+    const tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-whisper-transcode-"));
+    try {
+      const binDir = path.join(tmpDir, "bin");
+      await fs.mkdir(binDir, { recursive: true });
+      const whisperBin = path.join(binDir, "whisper-cli");
+      await fs.writeFile(whisperBin, "#!/usr/bin/env bash\nexit 0\n");
+      await fs.chmod(whisperBin, 0o755);
+      process.env.PATH = `${binDir}:${snapshot.PATH ?? ""}`;
+
+      const modelPath = path.join(tmpDir, "model.bin");
+      await fs.writeFile(modelPath, "model");
+      process.env.WHISPER_CPP_MODEL = modelPath;
+      process.env.OPENCLAW_OFFLINE = "1";
+
+      const oggPath = path.join(tmpDir, "input.ogg");
+      await fs.writeFile(oggPath, Buffer.from("OggS"));
+
+      let lastWhisperMediaArg: string | null = null;
+      runExecMock.mockImplementation(async (command: string, args: string[]) => {
+        if (command === "afconvert") {
+          const out = args.at(-1);
+          if (out) {
+            await fs.writeFile(out, Buffer.from("RIFF"));
+          }
+          return { stdout: "", stderr: "" };
+        }
+        if (command === "whisper-cli") {
+          lastWhisperMediaArg = args.at(-1) ?? null;
+          const ofIndex = args.findIndex((v) => v === "-of" || v === "--output-file");
+          const outputBase = ofIndex >= 0 ? args[ofIndex + 1] : undefined;
+          if (outputBase) {
+            await fs.writeFile(`${outputBase}.txt`, "请问今天是星期几\n");
+          }
+          return { stdout: "", stderr: "" };
+        }
+        return { stdout: "", stderr: "" };
+      });
+
+      const { buildProviderRegistry, createMediaAttachmentCache, normalizeMediaAttachments, runCapability } =
+        await import("./runner.js");
+
+      const ctx: MsgContext = {
+        Body: "<media:audio>",
+        MediaPath: oggPath,
+        MediaType: "audio/ogg; codecs=opus",
+      };
+      const media = normalizeMediaAttachments(ctx);
+      const cache = createMediaAttachmentCache(media);
+
+      const cfg = {
+        tools: { media: { audio: { enabled: true } } },
+      } as unknown as OpenClawConfig;
+
+      try {
+        const result = await runCapability({
+          capability: "audio",
+          cfg,
+          ctx,
+          attachments: cache,
+          media,
+          providerRegistry: buildProviderRegistry({}),
+        });
+        expect(result.outputs[0]?.text).toBe("请问今天是星期几");
+        expect(lastWhisperMediaArg).toMatch(/\.wav$/);
+      } finally {
+        await cache.cleanup();
+      }
+    } finally {
+      restoreEnv(snapshot);
+      await fs.rm(tmpDir, { recursive: true, force: true }).catch(() => {});
+    }
+  });
+});
+
